; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Formocracy"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

WorkdayState="*res://scripts/autoload/workday_state.gd"
ConfigDatabase="*res://scripts/autoload/config_database.gd"
LevelDirector="*res://scripts/autoload/level_director.gd"
OpeningMusic="*res://scripts/autoload/opening_music.gd"
Sfx="*res://scripts/autoload/sfx.gd"
CursorManager="*res://scripts/autoload/cursor_manager.gd"
GameStateSync="*res://scripts/autoload/game_state_sync.gd"
PauseMenu="*res://scripts/autoload/pause_menu.gd"
DeveloperConsole="*res://scripts/autoload/developer_console.gd"
RealityBridge="*res://RealityBridge.gd"

[debug]

developer_console_enabled=true
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
# IMPORTANT: 游戏必须以真正的全屏模式启动；不要改成最大化（2）或窗口模式（0）。
# 玩家启动后仍可通过 ESC 暂停菜单主动切换为窗口模式。
window/size/mode=3
# IMPORTANT: 全屏窗口内的 1280×720 游戏画布也必须铺满整个屏幕。
# canvas_items + ignore 会横纵独立缩放；不要改成 disabled/keep，否则会重新出现黑边。
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[gui]

theme/custom="res://themes/pixel_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

# 场景切换可能出现一帧没有任何 CanvasItem 的清屏间隙。
# 默认清屏色必须固定为纯黑，否则主菜单进入记录页时会产生单帧白/灰闪。
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
